datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  displayName           String?                @map("display_name")
  avatarUrl             String?                @map("avatar_url")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  
  spotifyConnection     SpotifyConnection?
  playlists             Playlist[]
  automationDefinitions AutomationDefinition[]
  automationExecutions  AutomationExecution[]
  aiRequests            AiRequest[]

  @@map("users")
}

model SpotifyConnection {
  id                    String    @id @default(uuid())
  userId                String    @unique @map("user_id")
  spotifyUserId         String    @unique @map("spotify_user_id")
  displayName           String?   @map("display_name")
  email                 String?
  accessTokenEncrypted  String    @map("access_token_encrypted")
  refreshTokenEncrypted String    @map("refresh_token_encrypted")
  expiresAt             DateTime  @map("expires_at")
  scope                 String    @default("")
  product               String    @default("unknown")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("spotify_connections")
}

model Playlist {
  id                String          @id @default(uuid())
  userId            String          @map("user_id")
  spotifyPlaylistId String?         @map("spotify_playlist_id")
  name              String
  description       String?
  isPublic          Boolean         @default(false) @map("is_public")
  snapshotId        String?         @map("snapshot_id")
  tracksCount       Int             @default(0) @map("tracks_count")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks            PlaylistTrack[]

  @@index([userId])
  @@index([spotifyPlaylistId])
  @@map("playlists")
}

model PlaylistTrack {
  id             String    @id @default(uuid())
  playlistId     String    @map("playlist_id")
  spotifyTrackUri String   @map("spotify_track_uri")
  trackName      String    @map("track_name")
  artistName     String    @map("artist_name")
  durationMs     Int       @map("duration_ms")
  position       Int       @default(0)
  addedAt        DateTime  @default(now()) @map("added_at")

  playlist       Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([playlistId])
  @@map("playlist_tracks")
}

model AutomationDefinition {
  id            String                @id @default(uuid())
  userId        String                @map("user_id")
  name          String
  description   String?
  isEnabled     Boolean               @default(true) @map("is_enabled")
  triggerConfig Json                  @map("trigger_config")
  actionConfig  Json                  @map("action_config")
  lastRunAt     DateTime?             @map("last_run_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions    AutomationExecution[]

  @@index([userId])
  @@map("automation_definitions")
}

model AutomationExecution {
  id             String               @id @default(uuid())
  automationId   String               @map("automation_id")
  userId         String               @map("user_id")
  idempotencyKey String               @unique @map("idempotency_key")
  status         String               @default("pending") // pending, running, success, failed
  startedAt      DateTime             @default(now()) @map("started_at")
  finishedAt     DateTime?            @map("finished_at")
  logs           Json                 @default("[]")
  errorMessage   String?              @map("error_message")
  resultPayload  Json?                @map("result_payload")

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  automation     AutomationDefinition @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([userId])
  @@index([idempotencyKey])
  @@map("automation_executions")
}

model AiRequest {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  prompt           String
  intentType       String   @map("intent_type")
  parsedParameters Json     @map("parsed_parameters")
  createdAt        DateTime @default(now()) @map("created_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_requests")
}
