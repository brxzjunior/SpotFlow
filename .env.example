# ==========================================
# SPOTFLOW AI — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env na raiz ou configure nos apps correspondentes
# ==========================================

# AMBIENTE E SERVIDOR (apps/api)
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173

# BANCO DE DADOS POSTGRESQL (Prisma ORM)
DATABASE_URL=postgresql://spotflow:spotflow_secret@localhost:5432/spotflow_db?schema=public

# SEGURANÇA E SESSÃO
JWT_SECRET=substitua_por_uma_chave_secreta_com_pelo_menos_32_caracteres_aleatorios
SESSION_SECRET=substitua_por_outra_chave_secreta_para_cookies_e_sessoes

# SPOTIFY WEB API (https://developer.spotify.com/dashboard)
# Cadastre o Redirect URI exato no Dashboard do Spotify: http://127.0.0.1:3001/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=seu_spotify_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_spotify_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/auth/spotify/callback
SPOTIFY_SCOPES="user-read-private user-read-email playlist-read-private playlist-read-collaborative playlist-modify-public playlist-modify-private user-library-read"

# MOTOR DE IA (Gemini ou OpenAI)
# Provedores suportados: "gemini" ou "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=sua_chave_gemini_api_key_aqui
OPENAI_API_KEY=sua_chave_openai_api_key_aqui
AI_MODEL_NAME=gemini-1.5-pro

# AUTOMAÇÃO N8N (automation/workflows)
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=segredo_compartilhado_para_validar_assinatura_de_webhooks

# CONFIGURAÇÕES DO FRONTEND (apps/web)
VITE_API_URL=http://localhost:3001
VITE_APP_NAME="SpotFlow AI"
