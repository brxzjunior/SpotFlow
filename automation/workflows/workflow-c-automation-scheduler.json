{
  "name": "SpotFlow AI — Workflow C (Automation Scheduler)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * 5"
            }
          ]
        }
      },
      "id": "node-cron-trigger",
      "name": "Weekly Schedule (Friday 18:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SPOTFLOW_API_URL || 'http://localhost:3001'}}/api/automations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-SpotFlow-Signature",
              "value": "={{$env.N8N_WEBHOOK_SECRET || 'secret'}}"
            }
          ]
        }
      },
      "id": "node-fetch-active-automations",
      "name": "Fetch Active Automations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsCode": "// Itera sobre as rotinas ativas e dispara a execução idempotente\nconst automations = $input.first().json.data || [];\nconst active = automations.filter(a => a.isEnabled);\n\nreturn active.map(aut => ({\n  json: {\n    automation_id: aut.id,\n    user_id: aut.userId,\n    idempotency_key: 'cron_' + aut.id + '_' + new Date().toISOString().slice(0, 10),\n    scheduled_time: new Date().toISOString()\n  }\n}));"
      },
      "id": "node-filter-active",
      "name": "Filter & Generate Idempotency Keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    }
  ],
  "connections": {
    "Weekly Schedule (Friday 18:00)": {
      "main": [
        [
          {
            "node": "Fetch Active Automations",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Active Automations": {
      "main": [
        [
          {
            "node": "Filter & Generate Idempotency Keys",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
